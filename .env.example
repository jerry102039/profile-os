# 複製成 .env 後填入；全部都可以留空（說明見 docs/configuration.zh-TW.md）

# 要 build 哪個 profile 資料夾；留空 = profile/，沒有的話用 profile.example/
PROFILE_DIR=

# 正式網址；留空就用 profile.yaml 的 site.url
SITE_URL=

# homelab 狀態來源（見 homelab/README.md）；留空就用 public/status.json 示範資料
PUBLIC_STATUS_URL=

# Cloudflare Web Analytics 的 token（Cloudflare 後台 → Web Analytics → 新增網站）；留空就不載入
PUBLIC_CF_BEACON_TOKEN=
