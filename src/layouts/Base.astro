---
import '../styles/base.css';
import { profile, fullName, defaultLocale, enabledLocales, t$, type Locale } from '../profile';
import { uiFor, href } from '../i18n/server';
import { contentLocale } from '../i18n/locale';
import { ldJson } from '../lib/seo';
import { fontsFor } from '../lib/fonts';

interface Props {
  locale: Locale;
  title: string;
  /** 分享預覽用的標題（預設同 title） */
  ogTitle?: string;
  description: string;
  /** 不含語言前綴的路徑，例如 '/'、'/projects/hos-web' */
  path: string;
  /** /og/ 底下的圖片路徑（不含 .png），例如 'zh-hant/home' */
  og: string;
  bodyClass?: string;
  type?: 'website' | 'article';
  /**
   * 這頁的內容真的有寫的語言（預設：所有啟用語言）。目前語言不在裡面 = fallback 頁：
   * canonical 指回原文那一頁、不輸出 hreflang。
   */
  alternates?: Locale[];
  /** 不讓搜尋引擎收錄（例如 404） */
  noindex?: boolean;
  /** schema.org 結構化資料 */
  jsonLd?: unknown;
  /** 文章的發布日期與標籤（og:article） */
  article?: { published: Date; tags?: string[] };
}

const { locale, title, ogTitle = title, description, path, og, bodyClass, type = 'website', alternates = enabledLocales, noindex = false, jsonLd, article } = Astro.props;
const t = uiFor(locale);
const site = Astro.site ?? new URL('http://localhost:4321');
const abs = (p: string) => new URL(p, site).href;
const original = alternates.includes(locale);
const canonical = abs(href(original ? locale : contentLocale(alternates, locale, defaultLocale), path));
const hreflangs = original && alternates.length > 1 ? alternates : [];
const xDefault = alternates.includes(defaultLocale) ? defaultLocale : alternates[0];
const ogImage = abs(`/og/${og}.png`);
const author = fullName;
const beacon = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
const fonts = fontsFor(locale, [profile.site.logo, fullName, t$(profile.owner.whoami, locale)].join(''));
---
<!doctype html>
<html lang={t.htmlLang} style={`--sans-font:${fonts.family}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f6f9f7" />
    <meta name="theme-color" content="#06090d" />
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && hreflangs.map((l) => <link rel="alternate" hreflang={uiFor(l).htmlLang} href={abs(href(l, path))} />)}
    {!noindex && hreflangs.length > 0 && <link rel="alternate" hreflang="x-default" href={abs(href(xDefault, path))} />}
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={profile.site.name} />
    <meta property="og:locale" content={t.ogLocale} />
    {hreflangs.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={uiFor(l).ogLocale} />)}
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogTitle} />
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    {article && <meta property="article:author" content={author} />}
    {article?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogTitle} />
    {jsonLd && <script type="application/ld+json" set:html={ldJson(jsonLd)} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- 字型不擋首次繪製：先 preload，載好再套用 -->
    {fonts.urls.map((u) => <link rel="preload" as="style" href={u} />)}
    {fonts.urls.map((u) => <link rel="stylesheet" href={u} media="print" onload="this.media='all'" />)}
    <!-- <noscript> 裡不能放 Astro 表達式（會把後面的 head 一起吞進去），所以整段當字串輸出 -->
    <Fragment set:html={`<noscript>${fonts.urls.map((u) => `<link rel="stylesheet" href="${u.replace(/&/g, '&amp;')}" />`).join('')}</noscript>`} />
    <!-- 繪製前套用深淺色與上次的偏好，避免閃爍 -->
    <script is:inline define:vars={{ storageKey: profile.site.storageKey, bootAnimation: profile.features.bootAnimation }}>
      (function () {
        var r = document.documentElement, p = {};
        try { p = JSON.parse(localStorage.getItem(storageKey) || '{}'); } catch (e) {}
        var m = p.mode || 'auto';
        r.dataset.mode = m;
        r.dataset.theme = m === 'auto' ? (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark') : m;
        if (p.palette && p.palette !== 'caffeine') r.dataset.palette = p.palette;
        if (p.accent) r.style.setProperty('--acc', p.accent);
        if (p.wallpaper) r.dataset.wallpaper = p.wallpaper;
        if (p.night) r.classList.add('night');
        var seen = false;
        try { seen = !!sessionStorage.getItem('booted'); } catch (e) {}
        if (!bootAnimation || seen || location.hash.length > 1 || matchMedia('(prefers-reduced-motion: reduce)').matches) r.classList.add('no-boot');
        // iOS Safari：聚焦字級 <16px 的輸入框會把整頁放大；maximum-scale=1 只擋這個行為，雙指縮放照常可用（iOS 10 起）
        if (/iP(hone|ad|od)/.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1)) {
          var v = document.querySelector('meta[name=viewport]');
          if (v) v.content += ', maximum-scale=1';
        }
      })();
    </script>
    <slot name="head" />
    {beacon && (
      <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: beacon })}></script>
    )}
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
