// Cloudflare Workers（靜態資源）部署設定：
// 網站是純靜態檔案，不需要任何伺服器程式；`npm run build` 產生 dist/ 後，`npx wrangler deploy` 直接上傳。
// 有這個檔案，wrangler 就不會自動偵測框架、改專案設定。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "profile-os",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
